APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

CENTRAL_DB_HOST=127.0.0.1
CENTRAL_DB_PORT=3306
CENTRAL_DB_DATABASE=db
CENTRAL_DB_USERNAME=user
CENTRAL_DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Hallazgo N40: en Docker y produccion la cola va por Redis, que es lo que trabaja
# Horizon (servicio `horizon` de docker-compose, Deployment `owomarket-horizon` en k8s).
# docker-compose ya fuerza `redis` por variable de entorno, asi que este valor solo
# gobierna cuando se trabaja fuera de Docker. Ahi va `sync`: los trabajos se ejecutan en
# linea, sin cola y sin worker.
#
# El motivo es concreto. Con `database` y sin un `queue:work` corriendo —que es lo normal
# en local— DispatchCentralOrderJob se queda en la tabla `jobs` para siempre: el comprador
# ve su confirmacion y el comerciante NO recibe el pedido. Un fallo silencioso en el camino
# del dinero, y ademas facil de confundir con "el checkout funciona".
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false


VITE_APP_NAME="${APP_NAME}"
VITE_APP_URL="${APP_URL}"
VITE_APP_CENTRAL_DOMAIN=dominio-central.local

# Zona horaria del negocio: decide el dia de calendario para cupones y tasas
# (Hallazgo Auditoria #4). Lo ALMACENADO sigue en UTC; ver la nota en config/app.php.
APP_BUSINESS_TIMEZONE=America/Caracas

APP_CENTRAL_DOMAIN=dominio-central.local

USER_PASSWORD_DEV=Test_12345678
DEFAULT_USER_TENANT_OWNER_PASSWORD_DEV=EndAdmin_12345678

INTERNAL_API_SECRET=clave_ultra_mega_secreta
TIME_ZONE_SISTEMA=America/Caracas
